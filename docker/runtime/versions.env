# Direct-package version pins for the runtime images.
# Alpine 3.21 (fixed release). Version numbers only — no sha256/digest pins.
# apk pins are exact; third-party tools are pinned by release version.

# --- base image (alpine 3.21, fixed release) ---
ALPINE_VERSION=3.21
BASH_VERSION=5.2.37-r0

# --- apk (Alpine 3.21, exact versions) ---
APK_BASH=5.2.37-r0
