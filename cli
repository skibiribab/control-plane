#!/usr/bin/env bash
# cli — thin bash dispatcher. Every command is a thin wrapper around an
# existing tool (git, gh, docker, opencode, shellcheck, ...).
# Model: cli <noun> <verb> [args...]  — noun = extension | language | concept.
set -euo pipefail

CLI_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
export CLI_ROOT

# shellcheck source=/dev/null
source "${CLI_ROOT}/lib/common.sh"
# shellcheck source=/dev/null
source "${CLI_ROOT}/lib/env.sh"
# shellcheck source=/dev/null
source "${CLI_ROOT}/lib/json.sh"
# shellcheck source=/dev/null
source "${CLI_ROOT}/lib/tools.sh"
# shellcheck source=/dev/null
source "${CLI_ROOT}/lib/report.sh"
# shellcheck source=/dev/null
source "${CLI_ROOT}/lib/files.sh"
# shellcheck source=/dev/null
source "${CLI_ROOT}/lib/media.sh"
# shellcheck source=/dev/null
source "${CLI_ROOT}/lib/lint.sh"
# shellcheck source=/dev/null
source "${CLI_ROOT}/lib/gh_limits.sh"

cli_help() {
  cat <<'EOF'
cli — workflow automation, repository checks, and release orchestration.
Model: cli <noun> <verb> [args...]  (noun = extension | language | concept)

  cli <noun> lint|test|scan|compress   file-type and language checks
  cli <noun> [args...]                 git/gh/docker/opencode/etc.

Nouns (file types):
  sh lint · dockerfile lint · structure lint · md lint · json lint
  tasks lint · yml lint · pdf lint · png|jpg|jpeg|gif|webp|svg|bmp lint
  mp4|mov|mkv|webm scan|compress · url (lychee)

Nouns (languages):
  rust · cpp · go · java · python · typescript · javascript · node
  each: cli <lang> lint|test

Nouns (base operations):
  git · gh · docker · opencode · integration

Run `cli <noun> --help` for details. Missing tools recommend the owning image.
EOF
}

main() {
  case "${1:-}" in
    ""|-h|--help|help)
      cli_help
      exit 0
      ;;
    -V|--version|version)
      cli_version
      exit 0
      ;;
    *) ;;
  esac

  local noun="${1:-}"
  shift || true

  local found=0 f
  for f in "${CLI_ROOT}"/commands/*/"${noun}".sh; do
    if [[ -f "$f" ]]; then
      # shellcheck source=/dev/null
      source "$f"
      found=1
    fi
  done
  if [[ "$found" -eq 0 ]]; then
    cli_die "unknown command: ${noun} (run 'cli --help')"
  fi

  # Uniform help: any -h/--help arg shows the noun's help.
  if [[ " $* " == *" -h "* || " $* " == *" --help "* ]]; then
    local helpfn="cli_${noun}_help"
    if declare -F "$helpfn" >/dev/null 2>&1; then
      "$helpfn"
      exit 0
    fi
  fi

  local fn="cli_${noun}_main"
  if declare -F "$fn" >/dev/null 2>&1; then
    "$fn" "$@"
  else
    cli_die "command ${noun} has no main entrypoint"
  fi
}

main "$@"
